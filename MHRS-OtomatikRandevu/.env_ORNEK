# MHRS Bot Ayarları
# Bu dosyayı .env olarak kaydedin ve kendi bilgilerinizle doldurun

# MHRS Giriş Bilgileri
MHRS_TC=12345678901
MHRS_PASSWORD=your_password

# Lokasyon ID'leri
# -1 = Farketmez
MHRS_PROVINCE_ID=70
MHRS_DISTRICT_ID=1439
MHRS_CLINIC_ID=196
MHRS_HOSPITAL_ID=280
MHRS_PLACE_ID=-1
MHRS_DOCTOR_ID=40143

# Tarih Ayarları
# Format: GG-AA-YYYY (gün-ay-yıl). Geçersiz tarihte bot başlamaz.
# START boşsa bugünden başlar. END boşsa bugünden 12 gün sonrasına kadar arar.
# END verilirse: o günün sonuna kadarki slotlar alınır, tarih geçince bot durur.
# Sadece tek gün için: ikisini de aynı güne ayarlayın.
MHRS_START_DATE=24-08-2025
MHRS_END_DATE=29-08-2025

# Arama Modu
# 1 = saat pencerelerini beklemeden sürekli ara (kısa tarih aralıkları için)
MHRS_CONTINUOUS=0
# İki deneme arası bekleme (saniye, en az 30)
MHRS_INTERVAL_SECONDS=120

# Telegram Bot Bildirimleri
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_FREQUENCY=10
